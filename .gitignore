# =============================================================================
# GLPI Control Center - .gitignore
# =============================================================================

# Environment files (NUNCA commite)
.env
.env.local
.env.staging
*.env
.env.*

# Exceção: manter templates como referência
!Backend/.env.example
!Backend/.env.local.example

# PHP
vendor/
composer.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temp
tmp/
temp/
.cache/

# Inventário e metadados gerados no ambiente; nunca distribuir cache de teste.
/Backend/data/cache/
/Backend/data/sync_report.json
/Backend/data/inventario_*.json
