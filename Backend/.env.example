# =============================================================================
# GLPI Control Center - Backend Environment Variables (Template)
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite arquivos .env.local no versionamento.
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
# Ambiente: local | production
APP_ENV=local

# Segredo aleatório com pelo menos 32 caracteres para assinar sessões.
AUTH_SESSION_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres
AUTH_SESSION_TTL=43200
AUTH_ALLOWED_DOMAINS=colegiosatelite.com.br
AUTH_ADMIN_EMAILS=kelvinrosendo@colegiosatelite.com.br

# -----------------------------------------------------------------------------
# GLPI API
# -----------------------------------------------------------------------------
# URL completa da API REST do GLPI (deve terminar em /apirest.php)
GLPI_URL=http://localhost/glpi/apirest.php

# Token da aplicação GLPI (Settings > General > API)
GLPI_APP_TOKEN=seu_app_token_aqui

# Token do usuário GLPI (Preferences > API Tokens)
GLPI_USER_TOKEN=seu_user_token_aqui

# Desabilitar validação SSL (1 = insecure, 0 = secure)
# Use 1 apenas para certificados autoassinados em desenvolvimento
GLPI_SSL_INSECURE=0

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Origens permitidas (separadas por vírgula para múltiplas)
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# GOOGLE OAuth (Autenticação)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# OPENAI (Opcional - Assistente)
# -----------------------------------------------------------------------------
# Chave da API OpenAI para o assistente de horários
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# SMTP (Notificações por E-mail)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
EMAIL_FROM=
EMAIL_FROM_NAME="GLPI Control Center"
