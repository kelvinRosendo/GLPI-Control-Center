APP_ENV=local

# API REST do GLPI no ambiente local
GLPI_URL=http://localhost/glpi/apirest.php

# Tokens do GLPI
GLPI_APP_TOKEN=seu_app_token_local
GLPI_USER_TOKEN=seu_user_token_local

# Em ambiente local com certificado interno/autossinado
GLPI_SSL_INSECURE=1

# Libera o frontend local
CORS_ORIGIN=http://localhost:3000

# Configuração de E-mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app
SMTP_ENCRYPTION=tls
EMAIL_FROM=seu-email@gmail.com
EMAIL_FROM_NAME="GLPI Control Center"

# Opcional: chave usada pelo assistente
OPENAI_API_KEY=sua_chave_local

# Segredo da sessão
AUTH_SESSION_SECRET=

# Domínios permitidos
AUTH_ALLOWED_DOMAINS=colegiosatelite.com.br

# E-mails de administração
AUTH_ADMIN_EMAILS=kelvinrosendo@colegiosatelite.com.br
